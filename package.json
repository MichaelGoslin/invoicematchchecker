{
  "name": "invoicematchchecker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo:price": "tsx scripts/demo-price.ts",
    "demo:rules": "tsx scripts/demo-rules.ts",
    "demo:extract": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local --import tsx scripts/demo-extract.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "score:truth": "tsx scripts/score-truth.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local --import tsx scripts/migrate.ts",
    "score:extraction": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local --import tsx scripts/score-extraction.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "next": "^16.4.5",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
