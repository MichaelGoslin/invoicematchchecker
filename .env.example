# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git. Never put real values in this file.

# Claude API key from the Anthropic Console (server-side only)
ANTHROPIC_API_KEY=

# Postgres connection string. On Vercel, the Supabase integration sets this.
# Supabase's pooler (port 6543) works: the app turns off prepared statements.
POSTGRES_URL=

# Shared passcode for the deployed app. Leave empty locally to skip the sign-in page.
APP_PASSCODE=

# Optional: database connections per server instance (default 5).
# Set to 1 for single-session test servers such as PGlite's socket server.
# POSTGRES_POOL_MAX=

# Not used yet: Vercel Blob, for keeping the uploaded files themselves.
# BLOB_READ_WRITE_TOKEN=
