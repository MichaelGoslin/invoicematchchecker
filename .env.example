# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git. Never put real values in this file.

# Claude API key from the Anthropic Console (server-side only)
ANTHROPIC_API_KEY=

# Postgres connection string (Neon or Supabase)
DATABASE_URL=

# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=

# Shared passcode for the deployed app
APP_PASSCODE=
